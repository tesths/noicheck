FLASK_ENV=development
# Local development can keep SQLite. Vercel production must use your Zeabur Postgres URL.
SECRET_KEY=replace-me-with-a-long-random-string
DATABASE_URL=sqlite:///instance/dev.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-me
BOOTSTRAP_ON_STARTUP=false
REQUIRE_PRODUCTION_ENV=false
SUBMISSION_CODE_MAX_LENGTH=20000
RATE_LIMIT_MAX_SUBMISSIONS=20
RATE_LIMIT_WINDOW_SECONDS=300
