# 生产环境模板。复制到 Vercel Environment Variables 或本地 `.env` 前，请替换所有 `replace-*` 值。
# 生成密钥示例：openssl rand -base64 32
FLASK_ENV=production
APP_ENV=production
SECRET_KEY=replace-with-strong-random-secret
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB

# AI 服务。后台模型切换当前只支持 deepseek-v4-flash / deepseek-v4-pro。
# 如果供应商要求 provider/model 形式，需要先同步更新 src/app/services/settings.py 的 ALLOWED_AI_MODELS。
AI_API_KEY=replace-with-ai-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=1
AI_MAX_PROMPT_CHARS=12000

# 首次部署或需要自动创建管理员时启用。已有管理员账号后，可以关闭 BOOTSTRAP_ON_STARTUP。
ADMIN_INIT_USERNAME=teacher
ADMIN_INIT_PASSWORD=replace-with-initial-admin-password
BOOTSTRAP_ON_STARTUP=true
REQUIRE_PRODUCTION_ENV=true

# Vercel Queues
JOB_QUEUE_BACKEND=vercel
VERCEL_QUEUE_REGION=iad1
VERCEL_QUEUE_TOPIC=noi_submission_jobs
JOB_QUEUE_PUBLISH_TIMEOUT_SECONDS=3
JOB_QUEUE_PUBLISH_MAX_ATTEMPTS=2
JOB_QUEUE_PUBLISH_RETRY_BACKOFF_SECONDS=0.2
INTERNAL_JOB_TOKEN=replace-with-internal-job-token
JOB_INTERNAL_REQUEST_TIMEOUT_SECONDS=15
JOB_INTERNAL_MAX_RETRIES=1
APP_BASE_URL=https://your-project.vercel.app

# 抓题、限流与缓存
OPENJUDGE_REQUEST_TIMEOUT=10
SUBMISSION_CODE_MAX_LENGTH=20000
RATE_LIMIT_MAX_SUBMISSIONS=20
RATE_LIMIT_WINDOW_SECONDS=300
PROBLEM_SNAPSHOT_CACHE_ENABLED=true
PROBLEM_SNAPSHOT_CACHE_TTL_SECONDS=86400
ENABLE_SUBMISSION_STATUS_POLLING=true

# Postgres 连接池。代码会对 pool_size、max_overflow、pool_timeout 做最小值兜底。
SQLALCHEMY_POOL_RECYCLE=300
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_TIMEOUT=10

# 后台任务并发。目标是控制外部抓题、AI 和数据库连接占用。
AI_CONCURRENCY_LIMIT_STUDENT=8
AI_CONCURRENCY_LIMIT_TEACHER=4
FETCH_CONCURRENCY_LIMIT=8

# 仅本地联调真实 Vercel Queue 或脱离 Vercel 环境复现时才需要：
# VERCEL_OIDC_TOKEN=your-vercel-oidc-token

# 本地开发可切回以下值：
# FLASK_ENV=development
# APP_ENV=development
# DATABASE_URL=sqlite:///instance/dev.db
# AI_API_KEY=your-test-key
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-pro
# JOB_QUEUE_BACKEND=inline
# BOOTSTRAP_ON_STARTUP=false
# REQUIRE_PRODUCTION_ENV=false
# APP_BASE_URL=http://127.0.0.1:5000

# 兼容旧变量名，必要时仍可继续使用：
# DEEPSEEK_API_KEY=your-legacy-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
